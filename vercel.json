{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/os",
      "destination": "/os/index.html"
    },
    {
      "source": "/gamified",
      "destination": "/index.html"
    },
    {
      "source": "/(studio|blueprint|seed|portfolio|workspace|dataroom|directory|zine)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
