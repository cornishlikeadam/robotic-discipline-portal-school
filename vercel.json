{
  "version": 2,
  "rewrites": [
    {
      "source": "/gamified",
      "destination": "/index.html"
    },
    {
      "source": "/c/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(studio|blueprint|seed|portfolio|workspace|dataroom|directory|zine)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
